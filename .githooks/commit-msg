#!/bin/sh
# commit-msg: validate Conventional Commits format (type(scope): description)
set -euo pipefail

MSG_FILE="${1:?commit message file required}"
MSG=$(head -1 "$MSG_FILE")

if ! echo "$MSG" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert)(\([a-z0-9-]+\))?: .+$'; then
  echo "✗ Invalid Conventional Commit message:"
  echo "  $MSG"
  echo ""
  echo "  Expected: type(scope): description"
  echo "  e.g.:     feat(keys): add limit-reset option"
  echo ""
  echo "  Allowed types: feat fix docs style refactor perf test chore ci build revert"
  exit 1
fi

# Enforce: no emoji, no trailing period, max 72 chars
# LC_ALL=C forces byte-based matching (avoids locale collation errors)
if echo "$MSG" | LC_ALL=C grep -qE '[😀-🙏🌀-🫿]'; then
  echo "✗ Commit message must not contain emojis"
  exit 1
fi
if echo "$MSG" | grep -qE '\.$'; then
  echo "✗ Commit message must not end with a period"
  exit 1
fi
if [ "${#MSG}" -gt 72 ]; then
  echo "✗ Commit message exceeds 72 characters (${#MSG})"
  exit 1
fi

echo "✓ Commit message OK"
