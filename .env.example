# OpenRouter CLI — environment
# Public API key (read-only commands: models, benchmarks, credits balance)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx

# Management key (full access: keys list/create/update/delete, analytics, activity)
# Required for `or keys`, `or activity`, `or analytics`
MANAGEMENT_KEY=sk-or-v1-xxxxxxxx
